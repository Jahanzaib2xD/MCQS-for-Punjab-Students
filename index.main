
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Punjab Board MCQs</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f8f4;color:#183329}
header{background:#087f5b;color:white;text-align:center;padding:30px 15px}
header h1{margin:0 0 8px}
main{max-width:850px;width:92%;margin:25px auto}
.card{background:white;padding:22px;margin-bottom:18px;border-radius:14px;border:1px solid #dce9e1}
h2{margin-top:0}
.filters{display:grid;grid-template-columns:1fr 1fr;gap:14px}
label{font-weight:bold}
select{display:block;width:100%;padding:11px;margin-top:6px;border:1px solid #cbdcd1;border-radius:8px;background:white;font-size:16px}
button{padding:12px 16px;border:0;border-radius:8px;cursor:pointer;font-size:16px;font-weight:bold}
.primary{background:#087f5b;color:white}
.secondary{background:#e5f2e9;color:#07543f}
button:disabled{opacity:.5;cursor:not-allowed}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
#questionCount,.note{color:#60736a}
.hidden{display:none!important}
#questionText{font-size:20px;font-weight:bold;margin:20px 0}
#options{display:grid;gap:10px}
.option{background:white;border:1px solid #cbdcd1;text-align:left;font-weight:normal}
.option.correct{background:#dff6e5;border:1px solid green}
.option.wrong{background:#ffe9e7;border:1px solid red}
#feedback{padding:12px;margin-top:12px;border-radius:8px}
.good{background:#dff6e5;color:#155c2a}
.bad{background:#ffe9e7;color:#8b2923}
.top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:#60736a}
footer{text-align:center;color:#60736a;padding:20px}
@media(max-width:550px){.filters{grid-template-columns:1fr}.card{padding:16px}}
</style>
</head>
<body>
<header>
<h1>Punjab Board MCQs</h1>
<p>Free practice for Classes 9–12</p>
</header>

<main>
<section class="card">
<h2>Choose Your Practice</h2>
<div class="filters">
<label>Class
<select id="classSelect">
<option value="9">Class 9</option>
<option value="10">Class 10</option>
<option value="11">Class 11</option>
<option value="12">Class 12</option>
</select>
</label>

<label>Subject
<select id="subjectSelect"></select>
</label>

<label>Chapter
<select id="chapterSelect">
<option value="all">All Chapters</option>
</select>
</label>

<label>Difficulty
<select id="difficultySelect">
<option value="all">All Levels</option>
<option value="Easy">Easy</option>
<option value="Medium">Medium</option>
<option value="Hard">Hard</option>
</select>
</label>
</div>

<p id="questionCount"></p>
<button id="startBtn" class="primary">Start Practice</button>
<p class="note">These are starter sample questions. Add more verified Punjab Board MCQs to the question bank in the code.</p>
</section>

<section id="quizPanel" class="card hidden">
<div class="top">
<span id="progress"></span>
<span id="scoreLabel">Score: 0</span>
<span id="difficultyTag"></span>
</div>
<div id="questionText"></div>
<div id="options"></div>
<div id="feedback" class="hidden"></div>
<div class="actions">
<button id="nextBtn" class="primary" disabled>Next Question</button>
<button id="quitBtn" class="secondary">Back</button>
</div>
</section>

<section id="resultPanel" class="card hidden">
<h2>Practice Complete!</h2>
<h2 id="finalScore"></h2>
<p id="resultMessage"></p>
<div class="actions">
<button id="againBtn" class="primary">Try Again</button>
<button id="changeBtn" class="secondary">Change Filters</button>
</div>
</section>
</main>

<footer>Keep learning. Keep improving.</footer>

<script>
// Add more questions inside this list.
// Keep the same structure for each question.
const bank = [
{cl:9,s:"Physics",c:"Motion",d:"Easy",q:"What is the SI unit of speed?",o:["Metre","Metre per second","Second","Kilogram"],a:1,e:"Speed is measured in metres per second (m/s)."},
{cl:9,s:"Physics",c:"Physical Quantities",d:"Easy",q:"Which instrument measures the diameter of a thin wire accurately?",o:["Metre rule","Stopwatch","Screw gauge","Thermometer"],a:2,e:"A screw gauge measures small diameters accurately."},
{cl:9,s:"Chemistry",c:"Atoms",d:"Easy",q:"What is the smallest unit of an element?",o:["Atom","Mixture","Solution","Compound"],a:0,e:"An atom is the smallest unit of an element."},
{cl:9,s:"Biology",c:"Cell Biology",d:"Easy",q:"Which cell structure controls most cell activities?",o:["Cell wall","Nucleus","Vacuole","Cytoplasm"],a:1,e:"The nucleus helps control cell activities."},
{cl:9,s:"Mathematics",c:"Real Numbers",d:"Medium",q:"Which number is irrational?",o:["1/2","0.25","√2","4"],a:2,e:"√2 cannot be written as a ratio of two integers."},
{cl:9,s:"English",c:"Grammar",d:"Easy",q:"Choose the correct plural of child.",o:["Childs","Childes","Children","Childrens"],a:2,e:"The plural of child is children."},

{cl:10,s:"Physics",c:"Electricity",d:"Easy",q:"What is the SI unit of electric current?",o:["Volt","Ohm","Ampere","Watt"],a:2,e:"Electric current is measured in amperes."},
{cl:10,s:"Physics",c:"Light",d:"Medium",q:"A convex lens is a:",o:["Diverging lens","Converging lens","Plane mirror","Prism"],a:1,e:"A convex lens converges parallel light rays."},
{cl:10,s:"Chemistry",c:"Chemical Reactions",d:"Easy",q:"A reaction that releases heat is:",o:["Endothermic","Exothermic","Neutral","Physical only"],a:1,e:"Exothermic reactions release heat."},
{cl:10,s:"Biology",c:"Inheritance",d:"Easy",q:"The basic unit of inheritance is the:",o:["Tissue","Organ","Gene","Cell wall"],a:2,e:"Genes carry hereditary information."},
{cl:10,s:"Mathematics",c:"Equations",d:"Easy",q:"What is the degree of a quadratic equation?",o:["1","2","3","4"],a:1,e:"A quadratic equation has highest power 2."},
{cl:10,s:"English",c:"Grammar",d:"Medium",q:"Choose the passive voice: Ali wrote a letter.",o:["Ali writes a letter.","A letter was written by Ali.","Ali is writing.","A letter wrote Ali."],a:1,e:"The simple past passive uses was/were plus the past participle."},

{cl:11,s:"Physics",c:"Vectors",d:"Easy",q:"A vector quantity has:",o:["Magnitude only","Direction only","Magnitude and direction","Neither"],a:2,e:"Vectors have both magnitude and direction."},
{cl:11,s:"Chemistry",c:"Atomic Structure",d:"Easy",q:"Atomic number equals the number of:",o:["Neutrons","Protons","Shells","Molecules"],a:1,e:"Atomic number is the number of protons."},
{cl:11,s:"Biology",c:"Biological Molecules",d:"Easy",q:"Proteins are made from:",o:["Fatty acids","Nucleotides","Amino acids","Water"],a:2,e:"Amino acids join together to form proteins."},
{cl:11,s:"Mathematics",c:"Sets",d:"Easy",q:"A set with no elements is called:",o:["Universal set","Empty set","Equal set","Infinite set"],a:1,e:"An empty set has no elements."},
{cl:11,s:"English",c:"Grammar",d:"Easy",q:"Choose the correct sentence.",o:["She go to school.","She going to school.","She goes to school.","She gone to school."],a:2,e:"She goes to school is correct simple present tense."},

{cl:12,s:"Physics",c:"Electrostatics",d:"Easy",q:"What is the SI unit of electric charge?",o:["Ampere","Coulomb","Volt","Ohm"],a:1,e:"Electric charge is measured in coulombs."},
{cl:12,s:"Chemistry",c:"Equilibrium",d:"Medium",q:"At chemical equilibrium, forward and reverse reaction rates are:",o:["Zero","Equal","Always increasing","Unequal"],a:1,e:"At dynamic equilibrium, the reaction rates are equal."},
{cl:12,s:"Biology",c:"Homeostasis",d:"Easy",q:"Which organs filter blood to form urine?",o:["Heart","Lungs","Kidneys","Stomach"],a:2,e:"The kidneys filter blood and produce urine."},
{cl:12,s:"Mathematics",c:"Integration",d:"Medium",q:"The integral of 1 with respect to x is:",o:["0","1","x + C","x² + C"],a:2,e:"The integral of 1 is x + C."},
{cl:12,s:"English",c:"Grammar",d:"Easy",q:"What is the past participle of write?",o:["Writed","Wrote","Written","Writing"],a:2,e:"The forms are write, wrote, written."}
];

const $ = id => document.getElementById(id);
let questions = [], index = 0, score = 0, answered = false;

function getQuestions(){
 return bank.filter(x =>
  x.cl === Number($("classSelect").value) &&
  x.s === $("subjectSelect").value &&
  ($("chapterSelect").value === "all" || x.c === $("chapterSelect").value) &&
  ($("difficultySelect").value === "all" || x.d === $("difficultySelect").value)
 );
}

function renderSubjects(){
 const old = $("subjectSelect").value;
 const subjects = [...new Set(bank.filter(x=>x.cl===Number($("classSelect").value)).map(x=>x.s))].sort();
 $("subjectSelect").innerHTML = subjects.map(s=>`<option>${s}</option>`).join("");
 if(subjects.includes(old)) $("subjectSelect").value = old;
 renderChapters();
}

function renderChapters(){
 const old = $("chapterSelect").value;
 const qs = bank.filter(x=>x.cl===Number($("classSelect").value)&&x.s===$("subjectSelect").value);
 const chapters = [...new Set(qs.map(x=>x.c))].sort();
 $("chapterSelect").innerHTML = '<option value="all">All Chapters</option>' +
  chapters.map(c=>`<option>${c}</option>`).join("");
 if(chapters.includes(old)) $("chapterSelect").value = old;
 updateCount();
}

function updateCount(){
 const n = getQuestions().length;
 $("questionCount").textContent = n+" sample question"+(n===1?"":"s")+" available.";
 $("startBtn").disabled = n===0;
}

function startPractice(){
 questions = getQuestions().slice();
 for(let i=questions.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [questions[i],questions[j]]=[questions[j],questions[i]];
 }
 index=0;score=0;
 $("resultPanel").classList.add("hidden");
 $("quizPanel").classList.remove("hidden");
 $("scoreLabel").textContent="Score: 0";
 renderQuestion();
}

function renderQuestion(){
 answered=false;
 const x=questions[index];
 $("progress").textContent=`Question ${index+1} of ${questions.length}`;
 $("scoreLabel").textContent="Score: "+score;
 $("difficultyTag").textContent=x.d;
 $("questionText").textContent=x.q;
 $("options").innerHTML="";
 $("feedback").className="hidden";
 $("feedback").textContent="";
 $("nextBtn").disabled=true;
 $("nextBtn").textContent=index===questions.length-1?"See Results":"Next Question";
 x.o.forEach((option,i)=>{
  const b=document.createElement("button");
  b.className="option";b.textContent=option;
  b.addEventListener("click",()=>chooseAnswer(i,b,x));
  $("options").appendChild(b);
 });
}

function chooseAnswer(choice,button,x){
 if(answered)return;
 answered=true;
 [...$("options").children].forEach((b,i)=>{
  b.disabled=true;
  if(i===x.a)b.classList.add("correct");
 });
 const f=$("feedback");
 if(choice===x.a){
  score++;
  f.textContent="Correct! "+x.e;
  f.className="good";
 }else{
  button.classList.add("wrong");
  f.textContent="Incorrect. Correct answer: "+x.o[x.a]+". "+x.e;
  f.className="bad";
 }
 $("scoreLabel").textContent="Score: "+score;
 $("nextBtn").disabled=false;
}

function nextQuestion(){
 if(!answered)return;
 if(index<questions.length-1){index++;renderQuestion();}
 else showResults();
}

function showResults(){
 $("quizPanel").classList.add("hidden");
 $("resultPanel").classList.remove("hidden");
 const percent=Math.round(score/questions.length*100);
 $("finalScore").textContent=`Your score: ${score}/${questions.length} (${percent}%)`;
 $("resultMessage").textContent=percent>=80?"Excellent work!":percent>=50?"Good effort. Keep practising!":"Keep learning and try again!";
}

function backToFilters(){
 $("quizPanel").classList.add("hidden");
 $("resultPanel").classList.add("hidden");
 window.scrollTo(0,0);
}

$("classSelect").addEventListener("change",renderSubjects);
$("subjectSelect").addEventListener("change",renderChapters);
$("chapterSelect").addEventListener("change",updateCount);
$("difficultySelect").addEventListener("change",updateCount);
$("startBtn").addEventListener("click",startPractice);
$("nextBtn").addEventListener("click",nextQuestion);
$("quitBtn").addEventListener("click",backToFilters);
$("againBtn").addEventListener("click",startPractice);
$("changeBtn").addEventListener("click",backToFilters);

renderSubjects();
</script>
</body>
</html>
